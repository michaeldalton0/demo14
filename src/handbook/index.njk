        <p class="resource-action-stack">
          <a class="btn btn-{{ resource.style }}" href="{{ resource.pdfUrl | withPrefix }}" target="_blank" rel="noopener">{{ resource.pdfLabel }}</a>
        </p>
        {% endfor %}

        <h2>{{ site.handbookUseHeading }}</h2>
        <p>{{ site.handbookUseBody }}</p>
      </article>
    </div>
  </div>
</section>
