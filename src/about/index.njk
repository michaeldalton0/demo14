---
layout: layouts/base.njk
title: About WPCNA
metaDescription: Learn what WPCNA is, how it supports White Plains neighborhood associations, and how residents can contact the council.
---

<section class="image-hero image-hero-about">
  <img src="{{ site.aboutImage | withPrefix }}" alt="{{ site.aboutImageAlt }}" loading="eager">
  <h1 class="image-hero-label">About</h1>
</section>

<section class="section about-page-section">
  <div class="wrap about-story">
    <article class="about-mission" aria-labelledby="about-mission-heading">
      <h2 id="about-mission-heading">{{ site.aboutMissionHeading }}</h2>
      <blockquote>
        <p>{{ site.aboutMissionQuote }}</p>
      </blockquote>
      <p class="about-attribution">{{ site.aboutMissionAttribution }}</p>
    </article>

    <section class="about-story-block" aria-labelledby="what-wpcna-does">
      <div class="about-section-header">
        <h2 id="what-wpcna-does">{{ site.aboutWhatHeading }}</h2>
        <p>{{ site.aboutWhatIntro }}</p>
      </div>

      <div class="about-card-grid about-card-grid-three">
        {% for card in site.aboutWhatCards %}
        <article class="about-card">
          <h3>{{ card.title }}</h3>
          <p>{{ card.body }}</p>
        </article>
        {% endfor %}
      </div>
    </section>

    <section class="about-story-block about-site-help" aria-labelledby="site-helps-residents">
      <div class="about-site-help-copy">
        <h2 id="site-helps-residents">{{ site.aboutHelpHeading }}</h2>
        {{ site.aboutHelpBody | paragraphs | safe }}
      </div>

      <div class="about-list-card">
        <ul class="about-resource-list">
          {% for item in site.aboutHelpList %}
          <li>{{ item }}</li>
          {% endfor %}
        </ul>
      </div>
    </section>

    <section class="about-story-block about-governance" aria-labelledby="governance-bylaws-committees">
      <p class="eyebrow">{{ site.aboutGovernanceEyebrow }}</p>
      <h2 id="governance-bylaws-committees">{{ site.aboutGovernanceHeading }}</h2>
      <p>{{ site.aboutGovernanceBody }}</p>
      <p>If you are looking for governance materials, committee information, or guidance on how the council is organized, <a href="{{ '/contact/' | withPrefix }}">contact WPCNA</a> and someone can point you in the right direction.</p>
    </section>
  </div>
</section>
