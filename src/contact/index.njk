---
layout: layouts/base.njk
title: Contact WPCNA
metaDescription: Send questions, corrections, meeting information, or neighborhood news to WPCNA.
---

<section class="page-hero contact-page-hero">
  <div class="wrap">
    <h1>Contact WPCNA</h1>
    <p>{{ site.contactIntro }}</p>
  </div>
</section>

<section class="section contact-page-section">
  <div class="wrap contact-page">
    <p class="form-status form-status-success" data-contact-sent hidden>Thank you — your message has been sent. A WPCNA member will get back to you.</p>
    <script>
      if (new URLSearchParams(location.search).get("sent") === "1") {
        document.querySelector("[data-contact-sent]").hidden = false;
      }
    </script>
    <form class="contact-form contact-page-form" action="{{ site.contactFormAction }}" method="POST">
      <input type="hidden" name="_subject" value="{{ site.contactFormSubject }}">
      {% if site.contactFormCc %}
        <input type="hidden" name="_cc" value="{{ site.contactFormCc }}">
      {% endif %}
      <input type="hidden" name="_template" value="table">
      <input type="hidden" name="_captcha" value="false">
      <input type="hidden" name="_next" value="{{ site.baseUrl }}/contact/?sent=1">
      <input type="text" name="_honey" class="form-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true">

      <div class="form-field">
        <label for="contact-name">Name</label>
        <input id="contact-name" name="name" type="text" autocomplete="name" required>
      </div>

      <div class="form-field">
        <label for="contact-email">Email</label>
        <input id="contact-email" name="email" type="email" autocomplete="email" required>
      </div>

      <div class="form-field">
        <label for="contact-subject">Subject</label>
        <input id="contact-subject" name="topic" type="text" required>
      </div>

      <div class="form-field">
        <label for="contact-message">Message</label>
        <textarea id="contact-message" name="message" rows="7" required></textarea>
      </div>

      <button class="btn btn-primary" type="submit">Send message</button>
    </form>
  </div>
</section>
